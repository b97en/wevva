# Copy to .env and fill in. `make run` loads it. Don't quote the values.

# Home Assistant, and a long-lived access token from your HA profile page
WEVVA_HA_URL=http://homeassistant.local:8123
WEVVA_HA_TOKEN=
# The Hive thermostat's climate entity
WEVVA_CLIMATE_ENTITY=climate.heating

# OpenWeather API key (https://home.openweathermap.org/api_keys)
WEATHER_API_KEY=
# forecast works with a free key; onecall needs a One Call 3.0 subscription
WEVVA_WEATHER_API=forecast

# The temperature to hold, °C
WEVVA_TARGET_TEMP=20

# Everything below is optional; the values shown are the defaults.

# Leave unset to use Home Assistant's home location
#WEVVA_LATITUDE=51.5074
#WEVVA_LONGITUDE=-0.1278

# Most to raise the setpoint above the target, and how far ahead to look
#WEVVA_MAX_BOOST=1
#WEVVA_LOOKAHEAD=1h

# HVAC modes wevva may adjust: heat (manual), auto (schedule)
#WEVVA_CONTROL_MODES=heat

#WEVVA_INTERVAL=15m
#WEVVA_DB=wevva.db
#WEVVA_DRY_RUN=false
#WEVVA_DEBUG=false
